# Database
DATABASE_URL=postgresql://globetrotter:globetrotter@localhost:5432/globetrotter?schema=public

# JWT
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
SERVER_PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
