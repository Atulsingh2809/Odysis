{
  "version": 2,
  "buildCommand": "npm run db:generate -w server && npm run build -w client",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "client/dist/$1",
      "check": true
    },
    {
      "src": "/(.*)",
      "dest": "client/dist/index.html"
    }
  ]
}
