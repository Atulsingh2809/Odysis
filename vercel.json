{
  "buildCommand": "npx prisma generate && npm run build -w client",
  "outputDirectory": "client/dist",
  "env": {
    "DATABASE_URL": "file:./prisma/dev.db"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
